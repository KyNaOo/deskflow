# .env du serveur de démo : cp deploy/.env.example .env, puis remplacer chaque CHANGE_ME.
# Secrets : `openssl rand -hex 32` pour chacun. Ce fichier ne quitte jamais le serveur.
# Les adresses publiques (front, API, stockage) se déduisent de DOMAIN (docker-compose.deploy.yml).

# Sous-domaine DuckDNS (ou domaine) qui pointe vers le serveur ; api., s3. et mail. en dépendent
DOMAIN=CHANGE_ME.duckdns.org

# Fichiers lus par `docker compose` sur le serveur : un simple `docker compose up -d --build` suffit
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.deploy.yml

# --- PostgreSQL ---
POSTGRES_USER=deskflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=deskflow
# Même mot de passe que POSTGRES_PASSWORD
DATABASE_URL=postgresql://deskflow:CHANGE_ME@postgres:5432/deskflow?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Stockage S3 (SeaweedFS) ---
S3_ENDPOINT=http://s3:8333
S3_BUCKET=attachments
S3_ACCESS_KEY=deskflow
S3_SECRET_KEY=CHANGE_ME

# --- E-mails : capturés par Mailpit, jamais envoyés ---
SMTP_URL=smtp://mailpit:1025

# --- Authentification ---
JWT_SECRET=CHANGE_ME
