{
  "name": "@deskflow/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Schémas zod et types partagés entre l'api et le front",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "postinstall": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@deskflow/tsconfig": "workspace:*",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
