// Schéma de la base Deskflow — source de vérité des tables.
// Après modification : `bin/pnpm db:migrate --name <description>`
//
// Convention : modèles et champs en camelCase côté TypeScript, tables et colonnes
// en snake_case côté PostgreSQL (@map / @@map) pour un SQL brut lisible
// (recherche vectorielle, plein texte, analytics).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum Plan {
  FREE
  PRO
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now()) @map("created_at")
  // Dernier numéro de ticket attribué : incrémenté dans la transaction de création (TicketsService)
  ticketCounter Int @default(0) @map("ticket_counter")

  users       User[]
  invitations Invitation[]
  tickets     Ticket[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]
  ticketsOpened   Ticket[]       @relation("TicketCustomer")
  ticketsAssigned Ticket[]       @relation("TicketAssignee")
  messages        Message[]
  attachments     Attachment[]

  // Un même e-mail peut exister dans deux organisations différentes
  @@unique([tenantId, email])
  @@map("users")
}

// Le jeton lui-même n'est jamais stocké : seulement son empreinte SHA-256.
// Tous les jetons issus d'une même connexion partagent un familyId (rotation, voir AuthService).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

// Même traitement que le refresh token : seule l'empreinte du jeton envoyé par e-mail est stockée.
model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  role       Role
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invitations")
}

// Numéro lisible (#42) séquentiel par tenant : chaque organisation a son propre ticket n° 1.
model Ticket {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  number          Int
  subject         String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  customerId      String         @map("customer_id") @db.Uuid
  assigneeId      String?        @map("assignee_id") @db.Uuid
  firstResponseAt DateTime?      @map("first_response_at")
  resolvedAt      DateTime?      @map("resolved_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  // Recherche plein texte : colonne générée par PostgreSQL à partir du sujet (voir la migration
  // add_ticket_search). Type inconnu de Prisma : filtrée uniquement en SQL brut. Le dbgenerated
  // reprend l'expression de la colonne, sans quoi Prisma voudrait la supprimer à chaque migration.
  searchVector    Unsupported("tsvector")? @default(dbgenerated("to_tsvector('french_unaccent'::regconfig, subject)")) @map("search_vector")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade : supprimer un tenant supprime ses utilisateurs et ses tickets par deux chemins à la
  // fois ; NoAction / Restrict échoueraient selon l'ordre des cascades. Le produit ne propose pas
  // de supprimer un utilisateur : à ajouter un jour, il faudrait plutôt l'anonymiser.
  customer User      @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    Message[]
  attachments Attachment[]

  @@unique([tenantId, number])
  // Liste des tickets : ordre de la pagination par curseur, avec ou sans filtre de statut
  @@index([tenantId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, assigneeId])
  @@index([searchVector], type: Gin)
  @@map("tickets")
}

// Pas de tenantId : un message est toujours lu ou écrit à travers son ticket, déjà filtré par tenant.
model Message {
  id             String   @id @default(uuid(7)) @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  isInternalNote Boolean  @default(false) @map("is_internal_note")
  aiGenerated    Boolean  @default(false) @map("ai_generated")
  createdAt      DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Cascade : voir Ticket.customer
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index([ticketId, createdAt])
  @@map("messages")
}

/// Fichier envoyé directement au stockage S3 par le navigateur (URL présignée).
/// Créée à la signature, sans message ; rattachée au message à son envoi.
/// Pas de tenantId : on y accède toujours à travers son ticket, déjà filtré par tenant.
model Attachment {
  id         String   @id @default(uuid(7)) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  messageId  String?  @map("message_id") @db.Uuid
  uploaderId String   @map("uploader_id") @db.Uuid
  /// Clé de l'objet dans le bucket : tenants/<tenantId>/tickets/<ticketId>/<uuid>
  fileKey    String   @unique @map("file_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  size       Int
  createdAt  DateTime @default(now()) @map("created_at")

  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Cascade : voir Ticket.customer
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
  @@map("attachments")
}
