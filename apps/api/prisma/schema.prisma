// Schéma de la base Deskflow — source de vérité des tables.
// Après modification : `bin/pnpm db:migrate --name <description>`
//
// Convention : modèles et champs en camelCase côté TypeScript, tables et colonnes
// en snake_case côté PostgreSQL (@map / @@map) pour un SQL brut lisible
// (recherche vectorielle, plein texte, analytics).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum Plan {
  FREE
  PRO
}

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Un même e-mail peut exister dans deux organisations différentes
  @@unique([tenantId, email])
  @@map("users")
}
