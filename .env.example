# Copier en .env : cp .env.example .env
# Les valeurs ci-dessous sont celles du docker-compose de développement.

# --- PostgreSQL ---
POSTGRES_USER=deskflow
POSTGRES_PASSWORD=deskflow
POSTGRES_DB=deskflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deskflow:deskflow@postgres:5432/deskflow?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Stockage S3 (SeaweedFS en local) ---
S3_PORT=8333
S3_ADMIN_PORT=23646
S3_ENDPOINT=http://s3:8333
S3_BUCKET=attachments
S3_ACCESS_KEY=deskflow
S3_SECRET_KEY=deskflow-secret

# --- E-mails (Mailpit) ---
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1025
SMTP_URL=smtp://mailpit:1025

# --- Authentification ---
# Valeur de DEV uniquement. En prod : une valeur aléatoire, ex. `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789

# --- Applications ---
API_PORT=3001
WEB_PORT=3000
